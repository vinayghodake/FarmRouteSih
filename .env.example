# ==============================================================================
# APMC Price Predictor Configuration
# ==============================================================================

# data.gov.in API Key (Register at https://data.gov.in to obtain your key)
# Leave empty or dummy to use the resilient offline synthetic generator
DATA_GOV_API_KEY=

# Agmarknet / APMC Resource ID on data.gov.in
# Default: Current Daily Price of Various Commodities from Various Markets (Mandi)
DATA_GOV_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070

# Default target commodity, market and state for price forecasting
DEFAULT_COMMODITY=Tomato
DEFAULT_MARKET=Pune
DEFAULT_STATE=Maharashtra

# Number of rows to fetch per batch (100 to 500)
DATA_FETCH_LIMIT=500

# Pipeline execution schedule (runs weekly)
# Day of week: mon, tue, wed, thu, fri, sat, sun
SCHEDULE_DAY_OF_WEEK=sun
# Hour in 24h format (e.g. 2 for 02:00 AM)
SCHEDULE_HOUR=2
SCHEDULE_MINUTE=0

# Forecast horizon in days (6 or 7 days)
FORECAST_HORIZON_DAYS=7

# Server settings
HOST=0.0.0.0
PORT=8000
